{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex",
  "version": "1.0.0",
  "identifier": "study.cortex.app",
  "build": {
    "beforeDevCommand": "bun run sidecars && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run sidecars && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cortex",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/age",
      "binaries/rclone"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
