{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex",
  "version": "1.0.27",
  "identifier": "study.cortex.app",
  "build": {
    "beforeDevCommand": "bun run sidecars && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run sidecars && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cortex",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; media-src 'self' asset: http://asset.localhost blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https: http: ws: wss:; frame-src 'self'; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/age",
      "binaries/rclone"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["poppler-utils", "ffmpeg"] },
      "rpm": { "depends": ["poppler-utils", "ffmpeg"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBNUMwMkRCRThCNDBBMDkKUldRSkNyVG8yd0pjcXFoSUlTcUNGdk1IMlFMdElZZXRrQnp5cndpSWtVYy9RZlpuS1lBTUpOOUEK",
      "endpoints": [
        "https://github.com/PndaMan/cortex/releases/latest/download/latest.json"
      ]
    }
  }
}
