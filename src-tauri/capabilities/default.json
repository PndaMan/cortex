{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Cortex main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default"
  ]
}
